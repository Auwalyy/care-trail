# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (web admin)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=0

# ── MongoDB (must be a replica set — transactions are required) ──
MONGODB_URI=mongodb://localhost:27017/caretrail?replicaSet=rs0&directConnection=true

# ── Auth (Phase 2) — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Redis / BullMQ (Phase 6+) ──
REDIS_URL=redis://localhost:6379

# ── API docs ──
API_DOCS_ENABLED=true
