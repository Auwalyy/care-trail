# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (web admin)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=0

# ── MongoDB (must be a replica set — transactions are required) ──
MONGODB_URI=mongodb+srv://auwaluizziddin2212-db_user:YPqhRPuxU3Y1Rg80@cluster0.h4og8vn.mongodb.net/

# ── Auth — generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Public URL of the web app (activation / password-reset links). Must be https in production.
WEB_APP_URL=http://localhost:3000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Redis / BullMQ (Phase 6+) ──
REDIS_URL=redis://localhost:6379

# ── API docs ──
API_DOCS_ENABLED=true
