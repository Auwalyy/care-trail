{
  "name": "@caretrail/sync-core",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first sync engine (outbox push, cursor pull, backoff) shared by the mobile app and tests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@caretrail/api-client": "0.1.0",
    "@caretrail/shared-types": "0.1.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
